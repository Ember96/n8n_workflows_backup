          "jsCode": "const IG_ID = '17841431723301731';\nlet out = { route:'skip', reason:'', commentId:'', psid:'', username:'', text:'', mediaId:'', source:'instagram' };\ntry {\n  const items = $input.all();\n  const p = (items && items[0] && items[0].json) ? items[0].json : {};\n  let data = p.payload || p.body || p;\n  if (typeof data === 'string') { data = JSON.parse(data); }\n  if (!data || typeof data !== 'object') { data = {}; }\n  const entries = Array.isArray(data.entry) ? data.entry : [];\n  for (const en of entries) {\n    const chs = Array.isArray(en.changes) ? en.changes : [];\n    for (const ch of chs) {\n      if (ch.field !== 'comments') { continue; }\n      const v = ch.value || {};\n      const from = v.from || {};\n      const psid = String(from.id || '');\n      const text = String(v.text !== undefined ? v.text : (v.message || '')).slice(0, 2000);\n      const low = text.toLowerCase();\n      if (psid === IG_ID) { out.route='skip'; out.reason='self-account'; continue; }\n      if (!text) { out.route='skip'; out.reason='empty-text'; continue; }\n      if (low.indexOf('aqui tienes el link') >= 0 || low.indexOf('gracias') >= 0) { out.route='skip'; out.reason='own-reply-text'; continue; }\n      if (low.indexOf('link') < 0 && low.indexOf('enlace') < 0) { out.route='skip'; out.reason='no-keyword'; continue; }\n      out.route='lead'; out.reason='match';\n      out.commentId = String(v.comment_id || v.id || '');\n      out.psid = psid;\n      out.username = from.username || 'instagram-lead';\n      out.text = text;\n      out.mediaId = String((v.media && v.media.id) || v.media_id || '');\n    }\n  }\n} catch (err) { out.route='skip'; out.reason='error'; }\nreturn [{ json: out }];"
