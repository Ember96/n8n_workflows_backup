    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json); const enriched=rows.map(r => { const low=Number(r.daysRangeLow), high=Number(r.daysRangeTop); const ok=Number.isFinite(low)&&Number.isFinite(high)&&low>0&&high>=low; return {...r, rangePct: ok?(high-low)/low*100 : null, eligible:r.eligible&&ok}; }); const good=enriched.filter(r => r.eligible && Number.isFinite(r.rangePct)); if (good.length < 3) throw new Error(`Only ${good.length} contracts have ask 20-600 and a usable delayed day range. Try a different ticker or a more liquid option chain.`); good.sort((a,b)=>b.rangePct-a.rangePct); const winners=good.slice(0,3); const round5=n=>Math.round(n/5)*5; return [{json:{ticker:rows[0].ticker,optionType:rows[0].optionType,referenceDirection:rows[0].referenceClose>=rows[0].referenceOpen?'bullish':'bearish',idealPriceRange:{min:round5(Math.min(...winners.map(x=>x.ask))),max:round5(Math.max(...winners.map(x=>x.ask)))},selectedContracts:winners,allAnalyzed:enriched.sort((a,b)=>(b.rangePct??-1)-(a.rangePct??-1)),dataNote:'delayed snapshot (Polygon free tier, 1-day lag acceptable)'}}];"
      },
