    {
      "parameters": {
        "jsCode": "const base=$('Choose calls or puts').first().json; const results=$json.results||[]; const today=new Date(); const eligible=results.filter(x=>x.ticker && x.expiration_date && new Date(x.expiration_date)>=today && Number.isFinite(x.strike_price) && (!x.expired)).map(x=>({...base,contractTicker:x.ticker,strike:x.strike_price,expiration:x.expiration_date})); if(!eligible.length) throw new Error('No contracts returned'); eligible.sort((a,b)=>a.strike-b.strike); const sample=[]; const N=Math.min(10,eligible.length); for(let i=0;i<N;i++) sample.push(eligible[Math.round(i*(eligible.length-1)/Math.max(1,N-1))]); return sample;"
      },
