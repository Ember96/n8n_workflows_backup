    {
      "parameters": {
        "jsCode": "const base=$('Spread contract selection').item.json; const r=$json?.results; if (r) { const day=r.day||{}; const last=r.last_quote||{}; const prevDay=r.prev_day||{}; const ask=Number(last.ask ?? day.c ?? r.last_trade?.p); const high=Number(day.h ?? prevDay.h); const low=Number(day.l ?? prevDay.l); return [{json:{...base, ask, daysRangeLow:low, daysRangeTop:high, eligible:Number.isFinite(ask)&&ask>=20&&ask<=600, eligibleRange:Number.isFinite(low)&&Number.isFinite(high)&&low>0&&high>=low, source:'snapshot'}}]; } throw new Error('Snapshot returned no result; will fall back to aggregates')"
      },
