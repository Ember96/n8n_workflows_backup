    {
      "parameters": {
        "jsCode": "const base=$('Extract ask + day range from snapshot').item.json; const d=$json.results?.[0]; if (!d) return [{json:{...base, eligible:false, eligibleRange:false, source:'aggregate-no-data'}}]; const high=Number(d.h), low=Number(d.l), ask=Number(d.c); return [{json:{...base, ask:Number.isFinite(base.ask)?base.ask:ask, daysRangeLow:low, daysRangeTop:high, eligible:Number.isFinite((Number.isFinite(base.ask)?base.ask:ask))&&(Number.isFinite(base.ask)?base.ask:ask)>=20&&(Number.isFinite(base.ask)?base.ask:ask)<=600, eligibleRange:Number.isFinite(low)&&Number.isFinite(high)&&low>0&&high>=low, source:'aggregate'}}];"
      },
      "id": "5a38a195-4428-4ce6-87b2-027b3e469542",
      "name": "Apply fallback range if snapshot lacked it",
