        "jsCode": "const p=$input.first().json; const data=p.body||p; const e=data.entry?.[0]; const c=e?.changes?.[0]; const v=c?.value||data; const t=v.text||v.message||v.comment||''; const cid=v.id||v.comment_id||v.message_id||data.social_id||''; const mid=v.media?.id||v.post_id||v.media_id||''; const f=v.from||data.from||{}; const uid=f.id||v.sender?.id||data.sender_id||null; return [{json:{source:(v.source||(String(cid).includes('ig')?'instagram':'facebook')), social_id:String(cid), user_id: uid?String(uid):null, social_handle:f.username||f.name||data.username||null, display_name:f.name||data.name||null, post_id: String(mid||'')||null, message:String(t).slice(0,2000), _raw:data}}]"
