      "parameters": {
        "jsCode": "const q=$input.first().json.query||$input.first().json; const b=$input.first().json.body||$input.first().json; const token='growbusy-social-verify-2026'; if(q['hub.mode']==='subscribe'&&q['hub.verify_token']===token){return [{json:{__respond:String(q['hub.challenge']), _isVerify:true}}];} return [{json:b, _isVerify:false}];"
