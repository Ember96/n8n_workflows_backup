      "parameters": {
        "jsCode": "const r=$input.first().json; const now=new Date().toISOString(); const E=/^\\+[1-9]\\d{1,14}$/; const s=r.smsPhone&&E.test(r.smsPhone)?r.smsPhone:null; return [{json:{externalId:String(r.social_id), userId: r.user_id||null, email:r.email||null, smsPhone:s, name:(r.display_name||r.social_handle||'Social lead').slice(0,120), socialHandle:r.social_handle||null, source:r.source, sourceCrm:($env.SOURCE_CRM||'zoho').toLowerCase(), sourceClient:$env.SOURCE_CLIENT||'growbusy-main', postId:r.post_id||null, message:r.message||null, consent:{emailMarketing:false,smsMarketing:false,version:'v1',capturedAt:now}, capturedAt:now}}]"
