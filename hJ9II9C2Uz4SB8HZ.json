      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $input.first().json;\nconst q = p.query || {};\nif (q['hub.mode'] === 'subscribe') {\n  return [{ json: { __challenge: String(q['hub.challenge'] || '') } }];\n}\nconst data = p.body || p;\nconst entry = data.entry && data.entry[0];\nconst change = entry && entry.changes && entry.changes[0];\nconst v = (change && change.value) || {};\nconst from = v.from || {};\nconst message = String(v.message || v.text || '').slice(0, 2000);\nconst isCommentAdd = v.item === 'comment' && v.verb === 'add';\nconst lower = message.toLowerCase();\nconst wantsLink = lower.includes('link') || lower.includes('enlace');\nif (!isCommentAdd || !wantsLink) { return [{ json: { __skip: true } }]; }\nreturn [{ json: {\n  externalId: String(v.comment_id || v.id || ''),\n  userId: from.id ? String(from.id) : null,\n  displayName: from.name || 'Social lead',\n  message: message,\n  postId: v.post_id || (v.post && v.post.id) || null,\n  permalink: (v.post && v.post.permalink_url) || null,\n  source: 'facebook'\n} }];"
      }
    },
    {
      "id": "a265aaad-59ad-4293-897c-df437ff53f9c",
      "name": "2. Canonical Contact (NAT-97)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $input.first().json;\nconst now = new Date().toISOString();\nconst parts = d.displayName.trim().split(/\\s+/);\nconst lastName = parts.pop() || d.displayName;\nconst firstName = parts.join(' ');\nreturn [{ json: {\n  externalId: d.externalId, userId: d.userId, name: d.displayName,\n  firstName: firstName, lastName: lastName, message: d.message,\n  postId: d.postId, permalink: d.permalink, source: d.source,\n  sourceCrm: 'zoho', sourceClient: 'growbusy-main',\n  consent: { emailMarketing: false, smsMarketing: false, version: 'v1', capturedAt: now },\n  capturedAt: now\n} }];"
      }
    },
