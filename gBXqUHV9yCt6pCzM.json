    "nodes": [
      {
        "parameters": {
          "path": "img.reporte.cliente",
          "responseMode": "lastNode",
          "options": {}
        },
        "id": "r1",
        "name": "Webhook — reporte",
        "webhookId": "55bcb4e3-039e-42ef-8d24-0a736009b424",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "// El token manda: el cliente sale de la tabla, no del query.\n// (Antes se aceptaba ?client= arbitrario junto a un token válido.)\nconst rows = $input.all().map(function(i){ return i.json; });\nconst hit = rows.find(function(r){ return r && r.client; });\nif (!hit) throw new Error('forbidden: token invalido');\nreturn [{ json: { client: hit.client, authorized: true } }];",
          "mode": "runOnceForAllItems",
          "language": "javaScript"
        },
        "id": "r2",
        "name": "Code — validar token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          224,
          0
        ]
      },
      {
        "parameters": {
          "url": "https://api.brevo.com/v3/emailCampaigns?limit=20",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {}
        },
        "id": "r3",
        "name": "Brevo — campañas",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          448,
          0
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "6vAwCJCUoOYI0Mnz",
            "name": "Brevo API key (header)"
          }
        }
      },
      {
        "parameters": {
          "resource": "deal",
          "operation": "getAll",
          "options": {}
        },
        "id": "r4",
        "name": "Zoho — deals",
        "type": "n8n-nodes-base.zohoCrm",
        "typeVersion": 1,
        "alwaysOutputData": true,
        "position": [
          672,
          0
        ],
        "credentials": {
          "zohoOAuth2Api": {
            "id": "R5WqgTreF3p3gViM",
            "name": "Zoho account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const bitems=$(\"Brevo — campañas\").all(); const zitems=$(\"Zoho — deals\").all(); const camps=((bitems[0]||{}).json||{}).campaigns||[]; let deals=[]; for(const it of zitems){const j=(it||{}).json||{}; if(Array.isArray(j.data)){deals=j.data;} else if(j.id&&j.Deal_Name){deals.push(j);}} let won=0,revenue=0; for(const d of deals){const st=String(d.Stage||\"\").toLowerCase(); if(/closed won|ganado/.test(st)){won++; revenue+=Number(d.Amount||0);}} const html=\"<html><head><meta charset=utf-8><title>Reporte GrowBusy</title></head><body><h1>Reporte GrowBusy</h1><p>Campañas: \"+camps.length+\"</p><p>Deals ganados: \"+won+\"</p><p>Revenue atribuido (last-touch 30d): $\"+revenue+\"</p><ul>\"+camps.map(c=>\"<li>\"+c.name+\" — \"+c.status+\"</li>\").join(\"\")+\"</ul></body></html>\"; return [{json:{html:html}}];"
        },
        "id": "r5",
        "name": "Code — unir y HTML",
        "type": "n8n-nodes-base.code",
        "typeVersion": 1,
        "position": [
          896,
          0
        ]
      },
      {
        "parameters": {
          "respondWith": "text",
          "responseBody": "={{ $json.html }}",
          "options": {}
        },
        "id": "r6",
        "name": "Responder — HTML",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          1120,
          0
        ]
      },
      {
        "id": "52a3b2d3-57c0-4ac1-9b64-c25c6448f6ca",
        "name": "Code — extraer token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Solo extrae el token; el hash se compara del lado de Postgres (pgcrypto).\nconst q = ($input.first().json.query || {});\nconst tok = String(q.token || '');\nif (!tok) throw new Error('forbidden: token invalido');\nreturn [{ json: { token: tok } }];"
        }
      },
      {
        "id": "e00574eb-61f5-4294-88bf-c9a0f599b86d",
        "name": "Supabase — buscar token",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          464,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT client FROM reportes.client_tokens WHERE token_hash = encode(digest($1, 'sha256'), 'hex') AND active = true LIMIT 1",
          "options": {
            "queryBatching": "single",
            "queryReplacement": "={{ $json.token }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "1gnIcgG4hDGKsy6f",
            "name": "Postgres account"
          }
        }
      }
