        "jsCode": "const out=[]; const now=Date.now(); const items=$input.all(); for(const it of items){const d=it.json; const mt=new Date(d.Modified_Time||d.Created_Time||0).getTime(); if(now-mt>20*60*1000) continue; const stage=(d.Stage||\"\").toLowerCase(); let action=\"sync\"; if(/closed won|ganado/.test(stage)) action=\"won\"; let cid=null; try{cid=d.Contact_Name.id||d.Contact_Name||null;}catch(e){} out.push({json:{action:action,dealId:String(d.id),dealStage:(d.Stage||null),dealAmount:(d.Amount||null),contactId:cid,modified:d.Modified_Time||null}});} return out;"
      },
