        "name": "Code — extraer token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const q = ($input.first().json.query || {});\nconst tok = String(q.token || '');\nif (!tok) throw new Error('forbidden: token invalido');\nreturn [{ json: { token: tok } }];"
        }
      },
      {
        "id": "2c831603-ee43-40a4-8894-5b9331ebfa5b",
        "name": "Supabase — buscar token",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          448,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT client FROM reportes.client_tokens WHERE token_hash = encode(digest($1, 'sha256'), 'hex') AND active = true LIMIT 1",
          "options": {
            "queryBatching": "single",
            "queryReplacement": "={{ $json.token }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "1gnIcgG4hDGKsy6f",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "fa79f90a-729c-486f-b13b-5762123bc2a1",
        "name": "Code — validar token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const rows = $input.all().map(function(i){ return i.json; });\nconst hit = rows.find(function(r){ return r && r.client; });\nif (!hit) throw new Error('forbidden: token invalido');\nreturn [{ json: { client: hit.client } }];"
        }
      },
