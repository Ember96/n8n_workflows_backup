          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ key: $json.key, expires: $json.expires }) }}",
          "options": {}
        },
        "credentials": {
          "httpHeaderAuth": {
            "id": "ZEOzpCl7BUrWfMB6",
            "name": "Firmador R2"
          }
        }
      }
