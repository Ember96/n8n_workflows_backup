        "name": "Code — armar URL",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1120,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// El cliente nunca ve la clave: solo recibe el redirect tras validar el token.\nconst rows = $input.all().map(function(i){ return i.json; });\nconst hit = rows.find(function(r){ return r && r.r2_key; });\nif (!hit) throw new Error('not found: aun no hay snapshot para este cliente');\nreturn [{ json: { url: 'https://pub-d9d8edcf1e2c4e86912b48b121ff93fb.r2.dev/' + hit.r2_key } }];"
