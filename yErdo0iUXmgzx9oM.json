    "nodes": [
      {
        "id": "dc4d94ce-6f26-434d-8ce4-45ed48de4b67",
        "name": "Webhook — ver reporte",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [
          0,
          0
        ],
        "parameters": {
          "path": "gb.reporte.ver",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "101ce7a4-7fd1-4a20-aff5-5428953798ff"
      },
      {
        "id": "3a249273-e0d9-4591-80cf-1cb38ee2178d",
        "name": "Code — extraer token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "// Orden: header Authorization Bearer, luego ?token=, luego ?share= (magic link del correo).\nconst first = $input.first().json;\nconst q = first.query || {};\nconst h = first.headers || {};\nconst auth = String(h.authorization || h.Authorization || '');\nlet token = '', share = '';\nconst m = auth.match(/^Bearer\\s+(.+)$/i);\nif (m) token = m[1].trim();\nelse if (q.token) token = String(q.token);\nif (q.share) share = String(q.share);\nif (!token && !share) throw new Error('forbidden: sin credencial');\nreturn [{ json: { token: token, share: share } }];"
        }
      },
      {
        "id": "2c831603-ee43-40a4-8894-5b9331ebfa5b",
        "name": "Supabase — buscar token",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          448,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH p AS (SELECT $1::jsonb AS j)\nSELECT client, 'token' AS via FROM reportes.client_tokens, p\nWHERE token_hash = encode(digest(COALESCE(p.j->>'token', ''), 'sha256'), 'hex')\n  AND COALESCE(p.j->>'token', '') <> '' AND active\nUNION ALL\nSELECT client, 'share' FROM reportes.share_links, p\nWHERE id = p.j->>'share' AND revoked_at IS NULL AND COALESCE(p.j->>'share', '') <> ''\nLIMIT 1",
          "options": {
            "queryBatching": "single",
            "queryReplacement": "={{ JSON.stringify({ token: $json.token || '', share: $json.share || '' }) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "1gnIcgG4hDGKsy6f",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "fa79f90a-729c-486f-b13b-5762123bc2a1",
        "name": "Code — validar token",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const rows = $input.all().map(function(i){ return i.json; });\nconst hit = rows.find(function(r){ return r && r.client; });\nif (!hit) throw new Error('forbidden: token invalido');\nreturn [{ json: { client: hit.client, via: hit.via || 'token' } }];"
        }
      },
      {
        "id": "34662d22-a7eb-41b4-bd0e-22ac03db38ea",
        "name": "Supabase — último snapshot",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          896,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT r2_key FROM reportes.snapshots WHERE client = $1 ORDER BY week DESC LIMIT 1",
          "options": {
            "queryBatching": "single",
            "queryReplacement": "={{ $json.client }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "1gnIcgG4hDGKsy6f",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "f2f230ee-7701-474d-9906-c9cb403c06d8",
        "name": "Code — armar URL",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1120,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const rows = $input.all().map(function(i){ return i.json; });\nconst hit = rows.find(function(r){ return r && r.r2_key; });\nif (!hit) throw new Error('not found: aun no hay snapshot para este cliente');\nreturn [{ json: { key: hit.r2_key, expires: 300 } }];"
        }
      },
      {
        "id": "3322999c-ca4a-4769-9ac2-7b8e153b574c",
        "name": "Responder — redirect",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          1344,
          0
        ],
        "parameters": {
          "respondWith": "redirect",
          "redirectURL": "={{ $json.url }}"
        }
      },
      {
        "id": "527baf03-85f2-4c65-94c0-d6bf7fa99f0f",
        "name": "Firmar URL",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1424,
