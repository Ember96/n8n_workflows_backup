        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const p = $input.first().json;\nconst b = p.body || p;\nconst store = $getWorkflowStaticData('global');\nif (!store.social_dedupe || typeof store.social_dedupe !== 'object') store.social_dedupe = {};\nconst map = store.social_dedupe;\nconst now = Date.now();\nfor (const k of Object.keys(map)) { if (now - map[k] > 48*3600*1000) delete map[k]; }\nconst day = new Date().toISOString().slice(0,10);\nconst uid = b.userId || '';\nconst pid = b.postId || '';\nlet duplicate = false;\nlet key = '';\nif (uid && pid) {\n  key = uid + '|' + pid + '|' + day;\n  if (map[key]) { duplicate = true; } else { map[key] = now; }\n}\nreturn [{ json: { duplicate: duplicate, key: key, storeSize: Object.keys(map).length } }];"
      }
