        "jsCode": "const raw=$input.first().json; const b=(raw.body||raw); let t=String(b.event||b.eventType||\"\").toLowerCase(); if(t===\"click\") t=\"clicked\"; const allowed=[\"delivered\",\"opened\",\"clicked\",\"hardbounce\",\"softbounce\",\"unsubscribed\",\"blocked\",\"spam\",\"bounced\",\"blocklisted\",\"stopped\",\"replied\"]; if(allowed.indexOf(t)<0) throw new Error(\"NAT-108: eventType no soportado: \"+t); const ev={eventId:(t+\"|\"+(b.email||b.smsPhone||\"?\")+\"|\"+(b.ts_event||b.eventId||Date.now()))}; const c={eventId:ev.eventId,eventType:t,email:(b.email||null),smsPhone:(b.smsPhone||null),campaignBrevoId:(b.camp_id||b.campaignBrevoId||b.campaignId||null),occurredAt:(b.date_event||b.occurredAt||new Date().toISOString())}; const st=$getWorkflowStaticData(\"global\"); st.seen=st.seen||{}; if(st.seen[c.eventId]){return [{json:{duplicate:true,event:c}}];} st.seen[c.eventId]=1; return [{json:{duplicate:false,event:c}}];"
      }
