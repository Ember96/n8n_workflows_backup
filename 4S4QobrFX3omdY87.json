      {
        "id": "62a29eb7-9824-4d52-a3bc-6010c3c2bb04",
        "name": "FB 1. Parse + Guard",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const PAGE_ID = '1348081288382156';\nlet out = { route:'skip', reason:'', commentId:'', authorId:'', authorName:'', text:'', postId:'', permalink:'', source:'facebook' };\ntry {\n  const items = $input.all();\n  const p = (items && items[0] && items[0].json) ? items[0].json : {};\n  let data = p.payload || p.body || p;\n  if (typeof data === 'string') { data = JSON.parse(data); }\n  if (!data || typeof data !== 'object') { data = {}; }\n  const entries = Array.isArray(data.entry) ? data.entry : [];\n  for (const en of entries) {\n    const chs = Array.isArray(en.changes) ? en.changes : [];\n    for (const ch of chs) {\n      if (ch.field !== 'feed') { continue; }\n      const v = ch.value || {};\n      const from = v.from || {};\n      const authorId = String(from.id || '');\n      const text = String(v.message || '').slice(0, 2000);\n      const low = text.toLowerCase();\n      if (authorId === PAGE_ID) { out.route='skip'; out.reason='self-page'; continue; }\n      if (v.item !== 'comment' || v.verb !== 'add') { out.route='skip'; out.reason='not-new-comment'; continue; }\n      if (low.indexOf('aqui tienes el link') >= 0 || low.indexOf('gracias') >= 0) { out.route='skip'; out.reason='own-reply-text'; continue; }\n      if (low.indexOf('link') < 0 && low.indexOf('enlace') < 0) { out.route='skip'; out.reason='no-keyword'; continue; }\n      out.route='lead'; out.reason='match';\n      out.commentId = String(v.comment_id || v.id || '');\n      out.authorId = authorId;\n      out.authorName = from.name || 'facebook-lead';\n      out.text = text;\n      out.postId = String(v.post_id || (v.post && v.post.id) || '');\n      out.permalink = String((v.post && v.post.permalink_url) || '');\n    }\n  }\n} catch (err) { out.route='skip'; out.reason='error'; }\nreturn [{ json: out }];"
        },
        "alwaysOutputData": true
      },
