      {
        "id": "bcb85b5b-45d7-499e-ae57-49e2c62e6ae4",
        "name": "Detect channel",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          320
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const items = $input.all();\nconst p = (items && items[0] && items[0].json) ? items[0].json : {};\nlet data = p.body || p;\nif (typeof data === 'string') { data = JSON.parse(data); }\nif (!data || typeof data !== 'object') { data = {}; }\nconst obj = String(data.object || '');\nconst entries = Array.isArray(data.entry) ? data.entry : [];\nlet field = '';\nfor (const en of entries) { if (en.changes && en.changes[0]) { field = String(en.changes[0].field || ''); break; } }\nconst channel = (obj === 'instagram' || field === 'comments') ? 'instagram' : 'facebook';\nreturn [{ json: { channel: channel, payload: data } }];"
        },
        "alwaysOutputData": true
      },
