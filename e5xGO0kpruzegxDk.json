      "parameters": {
        "jsCode": "const raw=$input.first().json; const c=(raw.body||raw); if(c.contractVersion!==\"1.0\") throw new Error(\"NAT-108: contractVersion debe ser 1.0\"); const srcc=(c.sourceCrm||\"\").toLowerCase(); if([\"zoho\",\"hubspot\",\"gohighlevel\",\"odoo\",\"brevo\",\"direct\"].indexOf(srcc)<0) throw new Error(\"NAT-108: sourceCrm desconocido\"); if(!c.externalId) throw new Error(\"NAT-108: falta externalId\"); if(!c.email && !c.smsPhone) throw new Error(\"NAT-108: requiere email o smsPhone\"); if(c.email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(c.email)) throw new Error(\"NAT-108: email invalido\"); if(c.smsPhone && !/^\\+[1-9][0-9]{7,14}$/.test(c.smsPhone)) throw new Error(\"NAT-108: smsPhone debe ser E.164\"); return [{json:{canonic:c}}];"
      }
    },
