        "language": "javaScript",
        "jsCode": "const d = $input.first().json;\nconst now = new Date().toISOString();\nconst name = d.displayName || 'Social lead';\nconst parts = name.trim().split(/\\s+/);\nconst lastName = parts.pop() || name;\nconst firstName = parts.join(' ');\nreturn [{ json: {\n  externalId: d.externalId, userId: d.userId, name: name,\n  firstName: firstName, lastName: lastName, message: d.message || '',\n  postId: d.postId || null, permalink: d.permalink || null, source: d.source || 'facebook',\n  sourceCrm: 'zoho', sourceClient: 'growbusy-main',\n  consent: { emailMarketing: false, smsMarketing: false, version: 'v1', capturedAt: now },\n  capturedAt: now\n} }];"
      }
